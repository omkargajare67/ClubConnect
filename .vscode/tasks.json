{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "Build ClubConnect",
            "command": "g++",
            "args": [
                "-std=c++17",
                "-Wall",
                "-Wextra",
                "main.cpp",
                "src/*/*.cpp",
                "-Iinclude",
                "-Ithird_party",
                "-o",
                "clubconnect",
                "-pthread",
                "-lws2_32",
                "-lmswsock"
            ],
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "PATH": "C:\\msys64\\ucrt64\\bin;${env:PATH}"
                }
            },
            "problemMatcher": ["$gcc"],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Compiles ClubConnect with C++17, -Wall -Wextra, pthread, and Winsock libraries."
        }
    ]
}
